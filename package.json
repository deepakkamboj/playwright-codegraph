{
  "name": "playwright-codegraph",
  "version": "0.1.0",
  "description": "Codegraph-powered affected unit and Playwright test selection for Rush monorepos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepakkamboj/playwright-codegraph.git"
  },
  "homepage": "https://github.com/deepakkamboj/playwright-codegraph#readme",
  "bugs": {
    "url": "https://github.com/deepakkamboj/playwright-codegraph/issues"
  },
  "type": "module",
  "bin": {
    "playwright-codegraph": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples",
    "playwright-codegraph.config.example.json",
    "test-scenarios.example.yml",
    "LICENSE",
    "README.md",
    "REPORTING.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint src test",
    "check": "npm run typecheck && npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "minimatch": "^10.1.1",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@colbymchenry/codegraph": ">=1.6.2 <2"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.48.1"
  },
  "keywords": [
    "playwright",
    "rush",
    "codegraph",
    "affected-tests",
    "test-selection"
  ],
  "license": "MIT"
}
